{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendrawer/artifacts/cartoon_set",
  "title": "Cartoon candidates",
  "description": "Cartoonize output: several colored cartoon candidates aligned with the photo, one of which is selected.",
  "type": "object",
  "required": [
    "version",
    "backend",
    "candidates"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "backend": {
      "type": "string"
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "style": {
      "type": "string"
    },
    "identity_mode": {
      "type": "string"
    },
    "commercial_safe": {
      "type": "boolean"
    },
    "memory_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "score": {
            "type": "object",
            "properties": {
              "structure": {
                "type": "number"
              },
              "color": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "selected_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
