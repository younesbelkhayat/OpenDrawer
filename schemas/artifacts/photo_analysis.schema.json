{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendrawer/artifacts/photo_analysis",
  "title": "Photo analysis",
  "description": "Intake output: who/what is in the photo, the foreground cutout on white, and the real colors of the photo.",
  "type": "object",
  "required": [
    "version",
    "source_photo",
    "image_size",
    "subjects",
    "cutout_path",
    "foreground_mask_path",
    "palette"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "source_photo": {
      "type": "string"
    },
    "image_size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "animal",
              "unknown"
            ]
          },
          "label": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height] in pixels"
          },
          "score": {
            "type": "number"
          },
          "face_bbox": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[x, y, width, height] in pixels"
              },
              {
                "type": "null"
              }
            ]
          },
          "mask_path": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Short English description used in prompts"
          }
        }
      }
    },
    "cutout_path": {
      "type": "string"
    },
    "foreground_mask_path": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hex"
        ],
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "lab": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "name": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
