# OpenDrawer - variables d'environnement (toutes optionnelles)
# Copiez ce fichier en .env. Aucune clé d'API : tout tourne en local.

# --- Emplacements ---
# Dossier des projets (défaut : ./projects)
# OPENDRAWER_PROJECTS_DIR=
# Dossier des poids de modèles (défaut : ./models) — pratique sur un autre disque
# OPENDRAWER_MODELS_DIR=

# --- Matériel ---
# Forcer le périphérique : cuda | mps | cpu
# OPENDRAWER_DEVICE=
# Forcer la stratégie mémoire : full_gpu | model_offload | sequential_offload | cpu
# (par défaut choisie selon la VRAM ; 6 Go + SDXL → sequential_offload)
# OPENDRAWER_MEMORY_STRATEGY=

# --- Licences ---
# 1 = n'utiliser que des modèles à licence permissive (équivaut à --commercial-safe)
# OPENDRAWER_COMMERCIAL_SAFE=

# --- ComfyUI (backend optionnel) ---
# COMFYUI_SERVER_URL=http://localhost:8188
# COMFYUI_IMAGE_SERVER_URL=
# Noms des fichiers dans les dossiers models/ de ComfyUI
# COMFYUI_CARTOON_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_CARTOON_CONTROLNET=controlnet-canny-sdxl-1.0-small.safetensors

# --- Backlot ---
# BACKLOT_PORT=4750
